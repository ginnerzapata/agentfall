# Agentfall local configuration
#
# The current engine scaffold does not read environment variables. These values
# document the local configuration required once the Cloudflare Worker,
# GitHub bootstrap authentication, and administrative commands are implemented.
# Leave secrets blank in this file. Copy it to .env for local-only use.

# Runtime identity and public origin. AGENTFALL_ENV is expected to be one of
# local, staging, or production.
AGENTFALL_ENV=local
AGENTFALL_ORIGIN=http://localhost:8787

# GitHub OAuth application credentials used only by the authentication
# bootstrap flow. The OAuth callback URL must match AGENTFALL_ORIGIN.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# High-entropy secret used to protect authentication state during the GitHub
# callback flow. Generate a distinct local value; never commit it.
AUTH_STATE_SECRET=

# High-entropy pepper used in addition to a one-way hash when storing issued
# Agentfall bearer credentials. It must be stable for a deployed environment.
CREDENTIAL_HASH_PEPPER=

# Credential for authenticated administrative CLI commands. Use a separate
# value for each environment and store production values as Cloudflare secrets.
ADMIN_BEARER_TOKEN=

# D1 is configured as a Cloudflare Worker binding, not with a database URL.
# Configure its local and deployed binding in wrangler.jsonc when persistence
# work begins; do not add a D1_DATABASE_URL here.
