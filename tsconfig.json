{
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@agentfall/contracts": ["./packages/contracts/src/index.ts"],
      "@agentfall/engine": ["./packages/engine/src/index.ts"]
    },
    "types": ["bun"],
    "verbatimModuleSyntax": true
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts"]
}
